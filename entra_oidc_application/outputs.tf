output "azure_client_id" {
  description = "The Application (client) ID generated by Azure"
  value       = azuread_application.this.client_id
}

output "azure_client_secret" {
  description = "The Client Secret value generated by Azure"
  value       = azuread_application_password.client_secret.value
  sensitive   = true
}

output "application_object_id" {
  description = "The object ID of the App Registration"
  value       = azuread_application.this.object_id
}

output "service_principal_object_id" {
  description = "The object ID of the Enterprise Application (Service Principal)"
  value       = azuread_service_principal.this.object_id
}
