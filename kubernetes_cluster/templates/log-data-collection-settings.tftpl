# Log data collection settings
[log_collection_settings]
   [log_collection_settings.stdout]
      enabled = ${enable_stdout_logs}
      exclude_namespaces = [${join(", ", formatlist("%q", stdout_exclude_namespaces))}]
      collect_system_pod_logs = [${join(", ", formatlist("%q", collect_system_pod_logs))}]

   [log_collection_settings.stderr]
      enabled = ${enable_stderr_logs}
      exclude_namespaces = [${join(", ", formatlist("%q", stderr_exclude_namespaces))}]
      collect_system_pod_logs = [${join(", ", formatlist("%q", collect_system_pod_logs))}]

   [log_collection_settings.env_var]
      enabled = ${collect_env_vars}

   [log_collection_settings.enrich_container_logs]
      enabled = ${enrich_container_logs}

   [log_collection_settings.collect_all_kube_events]
      enabled = ${collect_all_kube_events}

   [log_collection_settings.schema]
      containerlog_schema_version = "${containerlog_schema_version}"

   [log_collection_settings.enable_multiline_logs]
      enabled = ${enable_multiline_logs}

   [log_collection_settings.filter_using_annotations]
      enabled = ${filter_using_annotations}
